(ns culture.facts-test
  (:require [clojure.edn :as edn]
            [kotoba.lang.text :as str]
            [kotoba.test :refer [deftest is]]
            [culture.facts :as facts]))

(deftest kuala-lumpur-has-culture-basis
  (let [sb (facts/spec-basis "kuala-lumpur")]
    (is (= 9 (count sb)))
    (is (= (count sb) (count (set (map :culture/id sb)))))
    (is (every? #(str/starts-with? (:culture/url %) "https://") sb))
    (is (every? #(= "kuala-lumpur" (:culture/municipality %)) sb))
    (is (every? #(= "MYS" (:culture/country %)) sb))
    (is (every? #(seq (:culture/summary %)) sb))
    (is (every? #(string? (:culture/retrieved-at %)) sb))))

(deftest unknown-municipality-has-no-basis
  (is (nil? (facts/spec-basis "penang")))
  (is (nil? (facts/spec-basis "zzz"))))

(deftest coverage-is-honest
  (let [c (facts/coverage ["kuala-lumpur" "penang"])]
    (is (= 2 (:requested c)))
    (is (= 1 (:covered c)))
    (is (= ["penang"] (:missing-municipalities c)))))

(deftest by-kind-filters
  (is (= 4 (count (facts/by-kind "kuala-lumpur" :dish))))
  (is (= ["kuala-lumpur.beverage.teh-tarik"]
         (mapv :culture/id (facts/by-kind "kuala-lumpur" :beverage))))
  (is (empty? (facts/by-kind "kuala-lumpur" :product)))
  (is (empty? (facts/by-kind "penang" :dish))))

(deftest tx-file-matches-catalog
  (let [tx (edn/read-string (slurp "data/culture-tx.edn"))
        flat (mapcat val (sort-by key facts/catalog))]
    (is (= (vec flat) (vec tx)))))
